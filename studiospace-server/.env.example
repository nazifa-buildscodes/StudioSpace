PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=studiospace_app
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_NAME=StudioSpace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional: seed sample approved studios once when the studios collection is empty.
SEED_DEMO_STUDIOS=false
DEMO_HOST_EMAIL=demo.host@studiospace.local
DEMO_HOST_PASSWORD=ChangeThisDemoHostPassword123
